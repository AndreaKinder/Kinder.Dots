# ==============================================================================
# Plantilla de variables de entorno (.env.example)
# Copia este archivo a .env y define tus variables personales:
#   cp .env.example .env
# ==============================================================================

# Ollama / Modelos Locales (127.0.0.1 por defecto, 0.0.0.0 para exponer en red local)
OLLAMA_HOST="127.0.0.1"

# Claves de API / Inteligencia Artificial
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GITHUB_TOKEN=""

# Identidad Git opcional
# GIT_AUTHOR_NAME=""
# GIT_AUTHOR_EMAIL=""
