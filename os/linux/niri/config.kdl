// ============================================================================
// NIRI CONFIG - ESTILO OMARCHY + DUX SHELL (DMS 2.x) + PANEL TÁCTIL
// ============================================================================

// --- ENTRADA Y PANEL TÁCTIL ---
input {
    keyboard {
        xkb {
            layout "es" // Cambia a "latam" o "us" si usas otro teclado
        }
        repeat-delay 250
        repeat-rate 40
    }

    touchpad {
        tap
        natural-scroll
        dwt // Desactiva touchpad mientras escribes
    }

    touch {
        // Mapea el táctil a la pantalla interna (verifica el nombre con `niri msg outputs`)
        map-to-output "eDP-1"
    }

    focus-follows-mouse max-scroll-amount="0%"
}

// --- PANTALLA ---
include "dms/outputs.kdl"
// Comentado para usar el escalado HiDPI automático de Niri
/-output "eDP-1" {
    scale 1.0 // Ajusta a 1.25 o 1.5 si es pantalla HiDPI / tablet pequeña
}

// --- DISEÑO Y ESTÉTICA (Minimalismo TUI estilo tuigreet) ---
layout {
    gaps 6
    center-focused-column "never"
    background-color "#000000"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 1
        active-color "#ffffff"
        inactive-color "#333333"
        urgent-color "#e06c75"
    }
}

// --- ARRANQUE AUTOMÁTICO ---
// DMS se inicia automáticamente mediante el servicio systemd de usuario (dms.service)
spawn-at-startup "sh" "-c" "ln -sf \"$HOME/.config/branding/logo.svg\" /tmp/kinder-logo.svg"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "squeekboard"
// Descomenta si usas Nextcloud:
// spawn-at-startup "nextcloud" "--background"
// Descomenta la siguiente línea si tu equipo soporta rotación automática física:
// spawn-at-startup "rot8"

prefer-no-csd

environment {
    TERMINAL "ghostty"
    BROWSER "ardia"
}

screenshot-path "~/Imágenes/Capturas/Captura_%Y-%m-%d_%H-%M-%S.png"

// --- EVENTOS DE CONVERTIBLE (2-EN-1 / MODO TABLET) ---
switch-events {
    tablet-mode-on {
        spawn "gsettings" "set" "org.gnome.desktop.a11y.applications" "screen-keyboard-enabled" "true"
    }
    tablet-mode-off {
        spawn "gsettings" "set" "org.gnome.desktop.a11y.applications" "screen-keyboard-enabled" "false"
    }
}

// --- REGLAS DE VENTANA ---
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

// Borde blanco de 1px solo en el terminal activo (Ghostty y Alacritty)
window-rule {
    match app-id=r#"^(com\.mitchellh\.ghostty|Alacritty)$"#
    focus-ring {
        off
    }
    border {
        on
        width 1
        active-color "#ffffff"
        inactive-color "#00000000"
        urgent-color "#e06c75"
    }
    draw-border-with-background false
}

// Sin bordes ni focus-ring para web apps de FirefoxPWA (ej. WhatsApp)
window-rule {
    match app-id=r#"(?i)^ffpwa-"#
    focus-ring {
        off
    }
    border {
        off
    }
    draw-border-with-background false
}

// Pantalla completa para el modo Big Picture de Steam y juegos de Steam
window-rule {
    match app-id=r#"^steam$"# title=r#"(?i)big picture"#
    match app-id=r#"^steam_app_\d+$"#
    match app-id=r#"^gamescope$"#
    open-fullscreen true
}

// --- ATAJOS DE TECLADO (Flujo rápido tipo Omarchy + IPC de Dux Shell) ---
binds {
    // Aplicaciones principales
    Mod+Return { spawn "ghostty"; }
    Mod+B { spawn "ardia"; }
    Mod+W { spawn "firefoxpwa" "site" "launch" "01M7SHF20HH1SQ5DAMZ8HM0YB9"; } // Abre WhatsApp Web App (FirefoxPWA)
    Mod+E { spawn "dms" "files"; } // Abre Dux Files

    // Dictado por voz (Voxtype)
    Alt+Space { spawn "voxtype" "record" "toggle"; }

    // Controles de Dux Shell (Lanzador, Dash, Control Center, Bloqueo)
    Mod+Space { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+D { spawn "dms" "ipc" "call" "dash" "toggle"; }
    Mod+N { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Shift+C { spawn "dms" "ipc" "call" "control-center" "toggle"; }
    Mod+Escape { spawn "dms" "ipc" "call" "lock" "lock"; }

    // Portapapeles global en todo el sistema (Copiar, Cortar y Pegar)
    Mod+C { spawn "sh" "-c" "exec \"$HOME/.local/bin/niri-clipboard\" copy"; }
    Mod+X { spawn "sh" "-c" "exec \"$HOME/.local/bin/niri-clipboard\" cut"; }
    Mod+V { spawn "sh" "-c" "exec \"$HOME/.local/bin/niri-clipboard\" paste"; }

    // Gestión de ventanas
    Mod+Q { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+V { toggle-window-floating; }
    Mod+R { switch-preset-column-width; }
    Mod+O { toggle-overview; }

    // Navegación estilo Vim (HJKL) y flechas por la cinta de Niri
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }

    // Mover ventanas
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }

    // Espacios de trabajo (Workspaces)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    // Rueda del ratón (scroll vertical y horizontal, ej. Logitech MX Master 3)
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight     cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollLeft      cooldown-ms=150 { focus-column-left; }
    Mod+Shift+WheelScrollRight cooldown-ms=150 { move-column-right; }
    Mod+Shift+WheelScrollLeft  cooldown-ms=150 { move-column-left; }

    // Teclas multimedia y brillo (enlazadas a OSD de Dux Shell o directas)
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // Capturas de pantalla
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Salir de Niri
    Mod+Shift+E { quit; }
}
